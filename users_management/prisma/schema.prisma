generator client {
    provider = "prisma-client-js"
    output = "../generated/prisma"

}

datasource db {
     provider = "sqlite"
    
}

model user {
    id        String  @id @default(uuid())
    name      String 
    phone     String?
    email     String  @unique
    password  String 
    creatdAt  DateTime  @default(now())
    updatedAt DateTime  @updatedAt
}